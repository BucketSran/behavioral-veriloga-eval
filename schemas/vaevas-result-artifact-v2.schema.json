{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcadia-1.github.io/vaEVAS/schemas/vaevas-result-artifact-v2.schema.json",
  "title": "vaEVAS scored result with explicitly absent public authority",
  "description": "Absence-only v2. Profile-present results retain v1; final scoring authority remains mandatory.",
  "type": "object",
  "required": ["schema_version", "episode", "contract_identity", "trajectory", "submission", "final_judgment", "score_sidecar", "artifact_sha256"],
  "properties": {
    "schema_version": {"const": "vaevas-result-artifact-v2"},
    "episode": {
      "type": "object",
      "required": ["episode_id", "attempt_id", "task_id", "condition", "primary_outcome", "terminal_reason", "incidents"],
      "properties": {
        "episode_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "condition": {"enum": ["OneShot", "Agent-No-EVAS"]},
        "primary_outcome": {"type": "string", "minLength": 1},
        "terminal_reason": {"enum": ["submitted", "agent_timeout"]},
        "incidents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "message"],
            "properties": {"category": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}},
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "contract_identity": {
      "type": "object",
      "required": ["backend_profile_sha256", "registry_sha256", "effective_capability_sha256", "public_validation_profile_sha256", "final_test_profile_sha256", "final_profile_input_identity_sha256"],
      "properties": {
        "backend_profile_sha256": {"$ref": "#/$defs/sha256"},
        "registry_sha256": {"$ref": "#/$defs/sha256"},
        "effective_capability_sha256": {"$ref": "#/$defs/sha256"},
        "public_validation_profile_sha256": {"type": "null"},
        "final_test_profile_sha256": {"$ref": "#/$defs/sha256"},
        "final_profile_input_identity_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "trajectory": {
      "type": "object", "required": ["tail_sha256"],
      "properties": {"tail_sha256": {"$ref": "#/$defs/sha256"}},
      "additionalProperties": false
    },
    "submission": {
      "type": "object", "required": ["tree_sha256", "artifacts"],
      "properties": {
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "final_judgment": {
      "type": "object", "required": ["status", "judge_engine", "score", "submission_tree_sha256"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "judge_engine": {"type": "string", "minLength": 1},
        "score": {"type": ["number", "null"]},
        "submission_tree_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "score_sidecar": {
      "type": "object", "required": ["schema_id", "sha256", "immutable", "submission_tree_sha256", "score_authority"],
      "properties": {
        "schema_id": {"const": "vaevas-score-sidecar-v1"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "immutable": {"const": true},
        "submission_tree_sha256": {"$ref": "#/$defs/sha256"},
        "score_authority": {"enum": ["development_only", "formal"]}
      },
      "additionalProperties": false
    },
    "artifact_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "additionalProperties": false
}
