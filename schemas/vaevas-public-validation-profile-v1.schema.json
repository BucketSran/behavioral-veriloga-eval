{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcadia-1.github.io/vaEVAS/schemas/vaevas-public-validation-profile-v1.schema.json",
  "title": "vaEVAS public validation profile",
  "description": "Model-visible in-episode validation authority bound to a candidate tree and a public evaluator profile.",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "benchmark_release",
    "evaluator",
    "authority_phase",
    "visibility",
    "memory_policy",
    "input_scope",
    "allowed_feedback",
    "candidate_binding_required",
    "may_select_candidates"
  ],
  "properties": {
    "schema_version": {"const": "vaevas-public-validation-profile-v1"},
    "profile_id": {"type": "string", "minLength": 1},
    "benchmark_release": {"const": "benchmarkv4-r53"},
    "evaluator": {
      "type": "object",
      "required": ["engine", "version"],
      "properties": {
        "engine": {"const": "evas"},
        "version": {"const": "0.8.7"}
      },
      "additionalProperties": false
    },
    "authority_phase": {"const": "in_episode"},
    "visibility": {"const": "model_observation"},
    "memory_policy": {"const": "episode_local_public_only"},
    "input_scope": {"const": "candidate_tree"},
    "allowed_feedback": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "compile",
          "runtime",
          "metric",
          "log_excerpt",
          "waveform_summary"
        ]
      }
    },
    "candidate_binding_required": {"const": true},
    "may_select_candidates": {"const": true}
  },
  "additionalProperties": false
}
