{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcadia-1.github.io/vaEVAS/schemas/vaevas-evolution-manifest-v1.schema.json",
  "title": "vaEVAS evolution manifest",
  "description": "Frozen campaign-level contract for one AlphaApollo-style evolution condition.",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_id",
    "condition",
    "benchmark_release",
    "evaluator",
    "rounds",
    "branch_roster",
    "budgets",
    "tool_registry_sha256",
    "public_validation_profile_sha256",
    "final_test_profile_sha256",
    "memory_policy",
    "round_barrier_policy",
    "branch_timeout_policy",
    "global_deadline_policy",
    "selection_rule",
    "final_submission_policy"
  ],
  "properties": {
    "schema_version": {"const": "vaevas-evolution-manifest-v1"},
    "manifest_id": {"type": "string", "minLength": 1},
    "condition": {"type": "string", "minLength": 1},
    "benchmark_release": {"const": "benchmarkv4-r53"},
    "evaluator": {
      "type": "object",
      "required": ["engine", "version"],
      "properties": {
        "engine": {"const": "evas"},
        "version": {"const": "0.8.7"}
      },
      "additionalProperties": false
    },
    "rounds": {"type": "integer", "minimum": 1},
    "branch_roster": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["branch_id", "backend_profile_sha256", "model_ref"],
        "properties": {
          "branch_id": {"type": "string", "minLength": 1},
          "backend_profile_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "model_ref": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "budgets": {
      "type": "object",
      "required": ["per_branch", "total"],
      "properties": {
        "per_branch": {"$ref": "#/$defs/budgets"},
        "total": {"$ref": "#/$defs/budgets"}
      },
      "additionalProperties": false
    },
    "tool_registry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "public_validation_profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "final_test_profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "memory_policy": {"const": "episode_local_public_only"},
    "round_barrier_policy": {"const": "strict_all_branches_or_declared_timeout"},
    "branch_timeout_policy": {"const": "classify_branch_timeout_and_seal_round"},
    "global_deadline_policy": {"const": "discard_unsealed_round_use_prior_incumbent"},
    "selection_rule": {
      "type": "object",
      "required": ["metric_order", "tiebreak"],
      "properties": {
        "metric_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "tiebreak": {
          "type": "array",
          "prefixItems": [
            {"const": "candidate_tree_sha256"},
            {"const": "candidate_id"}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "final_submission_policy": {
      "const": "freeze_selected_candidate_then_final_test_once"
    }
  },
  "$defs": {
    "budgets": {
      "type": "object",
      "required": ["model_calls", "tool_calls", "public_validation_calls"],
      "properties": {
        "model_calls": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "public_validation_calls": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
