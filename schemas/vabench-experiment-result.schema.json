{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcadia-1.github.io/vaEVAS/schemas/vabench-experiment-result.schema.json",
  "title": "vaBench immutable experiment result",
  "type": "object",
  "required": [
    "schema_version",
    "recorded_at",
    "cell_id",
    "task_id",
    "mode",
    "model_execution",
    "final_submission",
    "final_trusted_replay",
    "outcome",
    "failure_taxonomy",
    "score_eligible",
    "score"
  ],
  "properties": {
    "schema_version": {"const": "vabench-experiment-result-v2"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "cell_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["G0", "G1", "G2", "G3", "G4", "G5"]},
    "model_execution": {
      "type": "object",
      "required": ["status", "raw_final_output"],
      "properties": {
        "status": {
          "enum": [
            "completed",
            "agent_timeout",
            "agent_resource_exhausted",
            "provider_failure",
            "runner_failure"
          ]
        },
        "raw_final_output": {
          "type": "object",
          "required": ["available", "sha256", "message"],
          "properties": {
            "available": {"type": "boolean"},
            "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
            "message": {"type": ["object", "null"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "final_submission": {
      "type": "object",
      "required": ["status", "artifacts", "tree_sha256", "diagnostics"],
      "properties": {
        "status": {"enum": ["available", "no_submission"]},
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "snapshot_path", "bytes", "sha256"],
            "properties": {
              "path": {"type": "string"},
              "snapshot_path": {"type": "string"},
              "bytes": {"type": "integer", "minimum": 0},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "tree_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "diagnostics": {"type": "array", "items": {"type": "string"}},
        "immutable": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "available"}}},
          "then": {
            "required": ["immutable"],
            "properties": {"immutable": {"const": true}}
          }
        }
      ],
      "additionalProperties": false
    },
    "final_trusted_replay": {
      "type": "object",
      "required": [
        "status",
        "executed",
        "test_manifest",
        "submission_tree_sha256",
        "evas_identity",
        "command",
        "adapter_result",
        "diagnostics",
        "failure_taxonomy"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_run",
            "passed",
            "compile_failure",
            "runtime_failure",
            "behavior_failure",
            "infrastructure_failure"
          ]
        },
        "executed": {"type": "boolean"},
        "test_manifest": {"type": "object"},
        "submission_tree_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "evas_identity": {"type": "object"},
        "command": {"type": ["object", "null"]},
        "adapter_result": {"type": ["object", "null"]},
        "diagnostics": {"type": "array", "items": {"type": "string"}},
        "failure_taxonomy": {"$ref": "#/definitions/failureTaxonomy"},
        "final_test_profile": {
          "type": "object",
          "description": "Optional typed authority; validated by final_test_profile_sha256 before execution.",
          "required": ["schema_version"],
          "properties": {"schema_version": {"const": "vaevas-final-test-profile-v1"}}
        },
        "score_sidecar_receipt": {
          "type": "object",
          "required": ["path", "sha256", "submission_tree_sha256", "final_profile_sha256", "final_profile_input_identity_sha256", "episode_id", "attempt_id", "task_id"],
          "properties": {
            "path": {"type": "string", "pattern": "^evidence/score-sidecars/[0-9a-f]{64}\\.json$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "submission_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "final_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "final_profile_input_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "episode_id": {"type": "string", "minLength": 1},
            "attempt_id": {"type": "string", "minLength": 1},
            "task_id": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "dependentRequired": {
        "final_test_profile": ["score_sidecar_receipt"],
        "score_sidecar_receipt": ["final_test_profile"]
      },
      "additionalProperties": false
    },
    "outcome": {
      "enum": [
        "passed",
        "agent_timeout",
        "agent_resource_exhausted",
        "no_submission",
        "compile_failure",
        "runtime_failure",
        "behavior_failure",
        "infrastructure_failure",
        "not_scored"
      ]
    },
    "failure_taxonomy": {"$ref": "#/definitions/failureTaxonomy"},
    "score_eligible": {"type": "boolean"},
    "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
  },
  "definitions": {
    "failureTaxonomy": {
      "type": "object",
      "required": [
        "schema_version",
        "primary_class",
        "secondary_classes",
        "stage",
        "responsibility",
        "retryable",
        "case_ids",
        "property_ids",
        "mutation_ids"
      ],
      "properties": {
        "schema_version": {"const": "vabench-failure-taxonomy-v1"},
        "primary_class": {
          "enum": [
            null,
            "invalid",
            "compile",
            "runtime",
            "functional",
            "mutation_survival",
            "property",
            "timeout",
            "resource_exhaustion",
            "behavior_unspecified",
            "infrastructure"
          ]
        },
        "secondary_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "invalid",
              "compile",
              "runtime",
              "functional",
              "mutation_survival",
              "property",
              "timeout",
              "resource_exhaustion",
              "behavior_unspecified",
              "infrastructure"
            ]
          }
        },
        "stage": {
          "enum": [
            "not_run",
            "completed",
            "model_execution",
            "artifact_gate",
            "compilation",
            "simulation",
            "functional_check",
            "mutation_check",
            "property_check",
            "behavior_check",
            "infrastructure",
            "not_scored"
          ]
        },
        "responsibility": {
          "enum": ["none", "candidate", "model", "system", "undetermined"]
        },
        "retryable": {"type": "boolean"},
        "case_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "property_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "mutation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "agent_timeout",
              "agent_resource_exhausted",
              "no_submission",
              "infrastructure_failure",
              "not_scored"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "score_eligible": {"const": false},
          "score": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "passed"}}},
      "then": {
        "properties": {
          "score_eligible": {"const": true},
          "score": {"const": 1.0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": ["compile_failure", "runtime_failure", "behavior_failure"]
          }
        }
      },
      "then": {
        "properties": {
          "score_eligible": {"const": true},
          "score": {"const": 0.0}
        }
      }
    }
  ],
  "additionalProperties": false
}
