{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcadia-1.github.io/vaEVAS/schemas/vaevas-backend-profile-v1.schema.json",
  "title": "vaEVAS agent backend profile",
  "description": "Backend-owned identity and proposal compatibility. Campaign, environment, tool, and judge values remain external contracts.",
  "type": "object",
  "required": [
    "schema_version",
    "backend_profile_id",
    "backend_family",
    "backend_version",
    "inference_mode",
    "supported_proposal_formats",
    "preferred_proposal_format",
    "action_schema_id",
    "observation_schema_id",
    "proposal_normalizer_id",
    "model_interface",
    "state_scope",
    "requires_campaign_contracts",
    "requires_environment_contracts"
  ],
  "properties": {
    "schema_version": {"const": "vaevas-backend-profile-v1"},
    "backend_profile_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "backend_family": {"type": "string", "minLength": 1},
    "backend_version": {"type": "string", "minLength": 1},
    "inference_mode": {
      "enum": ["single_trajectory", "round_based_evolution"]
    },
    "supported_proposal_formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["native_tool_calls", "strict_json"]}
    },
    "preferred_proposal_format": {
      "enum": ["native_tool_calls", "strict_json"]
    },
    "action_schema_id": {"const": "vaevas-action-v1"},
    "observation_schema_id": {"const": "vaevas-observation-v1"},
    "proposal_normalizer_id": {"const": "vaevas-proposal-normalizer-v1"},
    "model_interface": {
      "type": "object",
      "required": [
        "protocol",
        "supports_streaming",
        "supports_native_tool_calls",
        "supports_strict_json"
      ],
      "properties": {
        "protocol": {"type": "string", "minLength": 1},
        "supports_streaming": {"type": "boolean"},
        "supports_native_tool_calls": {"type": "boolean"},
        "supports_strict_json": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "state_scope": {
      "type": "object",
      "required": [
        "memory_scope",
        "shares_state_across_tasks",
        "shares_state_across_conditions"
      ],
      "properties": {
        "memory_scope": {"enum": ["none", "episode_local"]},
        "shares_state_across_tasks": {"const": false},
        "shares_state_across_conditions": {"const": false}
      },
      "additionalProperties": false
    },
    "requires_campaign_contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "model_identity",
          "decoding_policy",
          "turn_budget",
          "wall_time_budget",
          "condition_identity",
          "evolution_roster",
          "evolution_round_budget",
          "feedback_scope",
          "selection_policy",
          "submission_policy"
        ]
      },
      "allOf": [
        {"contains": {"const": "model_identity"}},
        {"contains": {"const": "decoding_policy"}},
        {"contains": {"const": "turn_budget"}},
        {"contains": {"const": "wall_time_budget"}},
        {"contains": {"const": "condition_identity"}}
      ]
    },
    "requires_environment_contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "clean_room_runtime",
          "proposal_tool_allowlist",
          "trajectory_sink",
          "candidate_store",
          "submission_freeze",
          "final_judge"
        ]
      },
      "allOf": [
        {"contains": {"const": "clean_room_runtime"}},
        {"contains": {"const": "proposal_tool_allowlist"}},
        {"contains": {"const": "trajectory_sink"}},
        {"contains": {"const": "candidate_store"}},
        {"contains": {"const": "submission_freeze"}},
        {"contains": {"const": "final_judge"}}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"preferred_proposal_format": {"const": "native_tool_calls"}}
      },
      "then": {
        "properties": {
          "supported_proposal_formats": {
            "contains": {"const": "native_tool_calls"}
          },
          "model_interface": {
            "properties": {"supports_native_tool_calls": {"const": true}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"preferred_proposal_format": {"const": "strict_json"}}
      },
      "then": {
        "properties": {
          "supported_proposal_formats": {
            "contains": {"const": "strict_json"}
          },
          "model_interface": {
            "properties": {"supports_strict_json": {"const": true}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "supported_proposal_formats": {
            "contains": {"const": "native_tool_calls"}
          }
        }
      },
      "then": {
        "properties": {
          "model_interface": {
            "properties": {"supports_native_tool_calls": {"const": true}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "supported_proposal_formats": {
            "contains": {"const": "strict_json"}
          }
        }
      },
      "then": {
        "properties": {
          "model_interface": {
            "properties": {"supports_strict_json": {"const": true}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "model_interface": {
            "properties": {"supports_native_tool_calls": {"const": true}}
          }
        }
      },
      "then": {
        "properties": {
          "supported_proposal_formats": {
            "contains": {"const": "native_tool_calls"}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "model_interface": {
            "properties": {"supports_strict_json": {"const": true}}
          }
        }
      },
      "then": {
        "properties": {
          "supported_proposal_formats": {
            "contains": {"const": "strict_json"}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"inference_mode": {"const": "round_based_evolution"}}
      },
      "then": {
        "properties": {
          "requires_campaign_contracts": {
            "allOf": [
              {"contains": {"const": "evolution_roster"}},
              {"contains": {"const": "evolution_round_budget"}},
              {"contains": {"const": "feedback_scope"}},
              {"contains": {"const": "selection_policy"}},
              {"contains": {"const": "submission_policy"}}
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
